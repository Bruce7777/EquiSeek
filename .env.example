# 默认不填写数据库配置：本机使用 ~/.equiseek/user-data/equiseek.sqlite3。
# LangGraph 检查点默认独立写入同目录的 equiseek-checkpoints.sqlite3。
EQUISEEK_AUTO_CREATE_SCHEMA=true
# 可选多 Worker 服务部署才需要 PostgreSQL；同时安装 equiseek[postgres]。
# EQUISEEK_DATABASE_URL=postgresql+asyncpg://equiseek:equiseek@127.0.0.1:54329/equiseek
# EQUISEEK_CHECKPOINT_URL=postgresql://equiseek:equiseek@127.0.0.1:54329/equiseek
EQUISEEK_ARTIFACT_ROOT=.equiseek/artifacts
EQUISEEK_WORKSPACE_ROOT=.equiseek/workspaces
# 桌面股票研究默认写入 ~/.equiseek/research-workspaces；仅需自定义时设置。
# EQUISEEK_RESEARCH_WORKSPACE_ROOT=~/.equiseek/research-workspaces
# 持仓数量、成本和备注的本地私有 JSON；默认 ~/.equiseek/user-data/portfolio.json。
# EQUISEEK_PORTFOLIO_PATH=~/.equiseek/user-data/portfolio.json
# 可选：用同结构 JSON 替换内置 2025-H1 宏观历史基线。
# EQUISEEK_MACRO_DATA_PATH=~/.equiseek/user-data/macro-snapshot.json
EQUISEEK_WORKSPACE_MAX_BYTES_PER_RUN=536870912
# local 仅用于可信代码的开发/演示，不是安全边界；不可信代码使用 docker。
EQUISEEK_SANDBOX_BACKEND=local
EQUISEEK_SANDBOX_IMAGE=equiseek-sandbox:0.1.0
EQUISEEK_SANDBOX_NETWORK_ALLOWED=false
EQUISEEK_SANDBOX_MAX_OUTPUT_BYTES=64000
EQUISEEK_SANDBOX_MEMORY_LIMIT=512m
EQUISEEK_SANDBOX_CPU_LIMIT=1.0
EQUISEEK_SANDBOX_PIDS_LIMIT=128
EQUISEEK_SANDBOX_REQUIRE_ISOLATION=false
EQUISEEK_SUBTASK_MAX_CONCURRENCY=4
EQUISEEK_MODEL_BASE_URL=https://api.openai.com/v1
EQUISEEK_MODEL_NAME=gpt-4.1-mini
# EQUISEEK_MODEL_API_KEY=
# 桌面投资 Agent 的可选联网搜索凭据（也可通过系统密钥库配置）。
# TAVILY_API_KEY=
EQUISEEK_WORKER_POLL_SECONDS=0.5
EQUISEEK_LEASE_SECONDS=60
EQUISEEK_LOG_LEVEL=INFO
# EQUISEEK_TELEMETRY_JSONL=.equiseek/traces.jsonl
